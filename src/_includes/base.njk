<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  {% if ogTitle %}<meta property="og:title" content="{{ ogTitle }}">{% endif %}
  {% if ogDescription %}<meta property="og:description" content="{{ ogDescription }}">{% endif %}
  {% if ogUrl %}<meta property="og:url" content="{{ ogUrl }}">{% endif %}
  <link rel="icon" href="/assets/img/favicon.ico" type="image/vnd.microsoft.icon">
  <link rel="stylesheet" href="/assets/css/isa.css?v=20260901c">
  <style>
    .prose .section-promo__layout{display:flow-root}
    .prose .section-promo__layout figure{float:left;width:160px;max-width:32%;margin:0 1rem .75rem 0}
    .prose .section-promo__layout figure img{width:160px!important;max-width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}
    @media(max-width:767px){.prose .section-promo__layout figure,.prose .section-promo__layout figure img{width:120px!important;max-width:35%}}
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
