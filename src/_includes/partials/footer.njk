{% from "partials/footer-columns.njk" import footerColumns %}
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__brand">
      <a href="/index.html" class="site-footer__logo-link">
        <img src="/assets/img/isystems-automation-logo-white.svg" alt="ISYSTEMS AUTOMATION" width="283" height="194" class="site-footer__logo">
      </a>
    </div>

    {{ footerColumns(footer, pageUrl or url, site) }}

    <div class="site-footer__bar">
      <div class="site-footer__copy">{{ site.copyright }}</div>
      <div class="site-footer__legal-links">
        <a href="/privacy.html">Privacy Policy</a>
        <a href="/cookies.html">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>
