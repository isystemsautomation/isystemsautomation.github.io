{% macro navList(items, currentUrl, mobile=false) %}
{% from "macros/icon.njk" import tabler %}
<ul class="nav__list{% if mobile %} nav__list--mobile{% endif %}">
  {% for item in items %}
    {% set isCurrent = item | navCurrent(currentUrl) %}
    {% if item.children %}
      {% if mobile %}
        <li class="nav__item nav__item--has-children">
          <details>
            <summary>{{ item.label }}{{ tabler('chevron-down', 20, 'nav__chevron') }}</summary>
            <ul>
              {% for child in item.children %}
                <li><a href="{{ child.url }}"{% if child.url | navUrlMatch(currentUrl) %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
              {% endfor %}
            </ul>
          </details>
        </li>
      {% else %}
        <li class="nav__item nav__item--has-children">
          <a href="{{ item.url }}" class="nav__link"{% if isCurrent %} aria-current="page"{% endif %} aria-haspopup="true">{{ item.label }}</a>
          <div class="nav__dropdown" role="menu">
            <ul class="nav__dropdown-grid">
              {% for child in item.children %}
                <li><a href="{{ child.url }}" role="menuitem"{% if child.url | navUrlMatch(currentUrl) %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </li>
      {% endif %}
    {% else %}
      <li class="nav__item">
        <a href="{{ item.url }}" class="nav__link"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
      </li>
    {% endif %}
  {% endfor %}
</ul>
{% endmacro %}
